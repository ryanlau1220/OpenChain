{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 5, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto" },
      "targets": [{ "expr": "up{job=\"openchain-backend\"}", "refId": "A" }],
      "title": "Backend scrape health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 10, "x": 5, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(openchain_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "sum(rate(openchain_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s", "refId": "A" }],
      "title": "HTTP 5xx rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "id": 4,
      "targets": [{ "expr": "sum by (network, status) (openchain_trace_queue_jobs)", "legendFormat": "{{network}} {{status}}", "refId": "A" }],
      "title": "Trace queue depth",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "id": 5,
      "targets": [{ "expr": "openchain_trace_queue_oldest_queued_seconds", "legendFormat": "{{network}}", "refId": "A" }],
      "title": "Oldest queued job",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "id": 6,
      "targets": [{ "expr": "time() - openchain_backup_last_success_unixtime", "legendFormat": "backup age", "refId": "A" }],
      "title": "Backup age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "targets": [{ "expr": "node_filesystem_avail_bytes{job=\"openchain-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"openchain-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "root free", "refId": "A" }],
      "title": "Root disk free",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 8,
      "targets": [{ "expr": "docker_container_mem_usage{job=\"openchain-containers\"}", "legendFormat": "{{container_name}}", "refId": "A" }],
      "title": "Container memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "targets": [{ "expr": "sum by (container_name) (rate(docker_container_cpu_usage_total{job=\"openchain-containers\"}[5m]))", "legendFormat": "{{container_name}}", "refId": "A" }],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 10,
      "targets": [{ "expr": "increase(openchain_provider_failures[6h])", "legendFormat": "{{network}} {{provider}}", "refId": "A" }],
      "title": "Provider failures (6h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 11,
      "targets": [{ "expr": "increase(openchain_provider_throttled[6h])", "legendFormat": "{{network}} {{provider}}", "refId": "A" }],
      "title": "Provider throttles (6h)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["openchain", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "OpenChain Operational Overview",
  "uid": "openchain-operations",
  "version": 1
}
