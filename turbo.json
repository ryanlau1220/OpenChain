{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "proto:generate"],
      "outputs": ["dist/**", "bin/**"]
    },
    "proto:generate": {
      "inputs": ["openchain/v1/*.proto", "buf.yaml", "buf.gen.yaml"],
      "outputs": ["gen/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
