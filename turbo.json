{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "proto:generate"],
      "outputs": ["dist/**", ".next/**"]
    },
    "proto:generate": {
      "inputs": ["src/**/*.proto", "buf.yaml", "buf.gen.yaml"],
      "outputs": ["gen/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
